# Copy to runner/.env on the Dell (install.ps1 does this for you).

# The admin site.
WORKER_URL=https://admin.samarthvmurthy.dev

# Same value as the worker secret: npx wrangler secret put RUNNER_TOKEN
RUNNER_TOKEN=

# Cloudflare Access service token (Zero Trust → Access → Service credentials).
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# The career-ops folder on this machine.
CAREER_OPS_ROOT=C:\career-ops

# Seconds between checks for new work.
POLL_SECONDS=15

# Phase 2 (AI workflows): from `claude setup-token`, so headless runs work
# without an interactive login.
CLAUDE_CODE_OAUTH_TOKEN=
